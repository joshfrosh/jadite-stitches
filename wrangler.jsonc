{
  "name": "jadite-stitches",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jadite-stitches-db",
      "database_id": "af6d420d-36bc-45d3-b867-f0aa0629c318"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jadite-stitches-media"
    }
  ]
}
